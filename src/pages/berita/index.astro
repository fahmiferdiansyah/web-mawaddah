---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NewsCard from '../../components/NewsCard.astro';

const all = (await getCollection('berita')).sort((a, b) => +b.data.tanggal - +a.data.tanggal);
const [first, ...rest] = all;
---
<Base title="Kabar & Kegiatan" description="Kabar terbaru kegiatan dakwah, pendidikan, dan sosial Yayasan Mawaddah Indonesia.">
  <PageHero eyebrow="Kabar" title="Cerita dari *lapangan.*"
    lead="Catatan kegiatan, laporan penyaluran, dan kisah para penerima manfaat — agar Anda tahu ke mana kebaikan Anda mengalir." />

  <section class="section-tight">
    <div class="container">
      {first && (
        <div class="feature">
          <NewsCard entry={first} feature />
        </div>
      )}
      {rest.length > 0 && (
        <div class="grid">
          {rest.map((n, i) => <NewsCard entry={n} i={i % 3} />)}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .feature { padding-bottom: var(--s-8); margin-bottom: var(--s-8); border-bottom: 1px solid var(--line); }
  @media (min-width: 960px) {
    .feature :global(.ncard) { grid-template-columns: 1.4fr 1fr; gap: var(--s-8); align-items: center; }
  }
  .grid { display: grid; gap: var(--s-8) var(--s-6); }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>

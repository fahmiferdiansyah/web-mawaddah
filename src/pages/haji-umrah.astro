---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { site, almaz, waLinkTo } from '../data/site';

const pesan = 'Assalamu’alaikum, saya ingin bertanya tentang paket umrah/haji Almaz Tour (info dari website Yayasan Mawaddah).';
const alasan = [
  { icon: 'shield', title: 'Resmi & terakreditasi', text: `Izin PPIU No. ${almaz.ppiu} dan akreditasi ${almaz.akreditasi} dari Kementerian Agama RI.` },
  { icon: 'book', title: 'Sesuai sunnah', text: 'Ibadah dibimbing oleh pembimbing Ahlussunnah wal Jama’ah, sesuai tuntunan Rasulullah ﷺ.' },
  { icon: 'users', title: 'Berpengalaman', text: `Melayani jamaah sejak ${almaz.since}, bermula dari Wesal Travel hingga kini menjadi ${almaz.brand}.` },
  { icon: 'tv', title: 'Terhubung dengan Wesal TV', text: 'Sebagian keuntungan Almaz Tour mendukung operasional Wesal TV, media dakwah keluarga islami.' },
] as const;
---
<Base title="Haji & Umrah" description={`Layanan haji dan umrah ${almaz.brand} (${almaz.company}), mitra terafiliasi Yayasan Mawaddah Indonesia — resmi PPIU No. ${almaz.ppiu}, akreditasi ${almaz.akreditasi} Kemenag RI.`}>
  <PageHero eyebrow="Haji & Umrah" title="Menuju Tanah Suci *bersama Almaz Tour.*"
    lead={`${almaz.company} (${almaz.brand}) adalah biro perjalanan haji dan umrah yang terafiliasi dengan ${site.name}. ${almaz.tagline}`}
    crumbs={[{ href: '/haji-umrah/', label: 'Program' }]}>
    <div class="cluster">
      <a class="btn" href={waLinkTo(almaz.whatsapp[0].wa, pesan)} target="_blank" rel="noopener"><Icon name="chat" /> Tanya paket via WhatsApp</a>
      <a class="btn btn-ghost-light" href={almaz.paket} target="_blank" rel="noopener">Lihat paket &amp; harga terbaru <Icon name="arrow-up-right" /></a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="layanan-title">
    <div class="container">
      <SectionHead eyebrow="Layanan" id="layanan-title" title="Satu pintu untuk *ibadah ke Tanah Suci*" align="split"
        lead="Mulai dari umrah, haji khusus, hingga wisata halal — dengan pilihan tabungan dan cicilan agar lebih ringan." />
      <ul class="layanan">
        {almaz.layanan.map((l, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <span class="l-ic"><Icon name={l.icon} /></span>
            <h3>{l.title}</h3>
            <p class="muted">{l.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-sand" aria-labelledby="alasan-title">
    <div class="container">
      <SectionHead eyebrow="Mengapa Almaz Tour" id="alasan-title" title="Aman, nyaman, *dan berkesan*" />
      <ul class="alasan">
        {alasan.map((a, i) => (
          <li data-reveal style={`--i:${i % 2}`}>
            <span class="a-ic"><Icon name={a.icon} /></span>
            <div><h3>{a.title}</h3><p class="muted">{a.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="afiliasi-title">
    <div class="container afil">
      <div class="stack" style="--stack: var(--s-4)">
        <p class="eyebrow" data-reveal>Afiliasi</p>
        <h2 id="afiliasi-title" class="display bar-gold" data-reveal>Yayasan Mawaddah &amp; <em>Almaz Tour</em></h2>
        <p class="muted" data-reveal style="--i:2">
          Yayasan Mawaddah Indonesia dan {almaz.company} berada dalam satu keluarga besar dakwah yang sama dan berkantor di Graha Mawaddah, Jakarta Timur.
          Layanan haji dan umrah dijalankan dan dipertanggungjawabkan oleh {almaz.company}; yayasan menyediakan halaman ini sebagai informasi bagi jamaah dan donatur.
        </p>
        <p class="small muted" data-reveal style="--i:3">Harga, jadwal keberangkatan, dan ketersediaan seat berubah-ubah — selalu konfirmasi langsung ke Almaz Tour.</p>
      </div>
      <div class="kartu" data-reveal style="--i:2">
        <p class="eyebrow">Almaz Tour</p>
        <p class="serif k-name">{almaz.company}</p>
        <dl>
          <div><dt>Izin</dt><dd>PPIU No. {almaz.ppiu} · Akreditasi {almaz.akreditasi} Kemenag RI</dd></div>
          <div><dt>Dahulu</dt><dd>{almaz.formerly}</dd></div>
          <div><dt>Kantor Jakarta</dt><dd>{almaz.officeJakarta}</dd></div>
          <div><dt>Kantor pusat</dt><dd>{almaz.officePusat}</dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${almaz.email}`}>{almaz.email}</a></dd></div>
          <div><dt>Situs</dt><dd><a href={almaz.site} target="_blank" rel="noopener">almaztour.id</a></dd></div>
        </dl>
        <ul class="wa">
          {almaz.whatsapp.map((w) => (
            <li><a class="btn btn-sm btn-ghost" href={waLinkTo(w.wa, pesan)} target="_blank" rel="noopener"><Icon name="chat" /> {w.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .layanan { list-style: none; padding: 0; display: grid; gap: var(--s-4); }
  .layanan li { display: grid; gap: var(--s-2); align-content: start; padding: var(--s-6); border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-1); border-top: 4px solid var(--gold); }
  .l-ic, .a-ic { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--gold); color: var(--plum); margin-bottom: var(--s-2); }
  .layanan h3 { font-size: 1.2rem; }
  @media (min-width: 640px) { .layanan { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .layanan { grid-template-columns: repeat(3, 1fr); } }

  .alasan { list-style: none; padding: 0; display: grid; gap: var(--s-4); }
  .alasan li { display: flex; gap: var(--s-4); align-items: flex-start; padding: var(--s-5); border-radius: var(--r-md); background: #fff; box-shadow: var(--shadow-1); }
  .a-ic { flex: none; margin: 0; width: 3rem; height: 3rem; }
  .alasan h3 { font-size: 1.1rem; margin-bottom: 0.2rem; }
  @media (min-width: 800px) { .alasan { grid-template-columns: repeat(2, 1fr); } }

  .afil { display: grid; gap: var(--s-7); align-items: start; }
  .afil h2 { font-size: var(--step-3); }
  .kartu { display: grid; gap: var(--s-3); padding: var(--s-6); border-radius: var(--r-lg); background: var(--grad-dark); color: var(--on-plum); }
  .k-name { font-size: 1.35rem; color: #fff; }
  .kartu .eyebrow { justify-self: start; }
  .kartu dl { display: grid; gap: var(--s-3); margin: 0; }
  .kartu dt { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: #e6bd4a; }
  .kartu dd { margin: 0; color: var(--on-plum-soft); }
  .kartu a { text-decoration: underline; text-underline-offset: 3px; }
  .wa { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-2); }
  .wa .btn { --btn-fg: var(--on-plum); box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.75); }
  @media (min-width: 960px) { .afil { grid-template-columns: 1fr 1fr; gap: var(--s-9); } }
</style>

---
/**
 * Satu rute untuk:
 *  - halaman kategori: /sosial/, /dakwah/, /pendidikan/
 *  - halaman program:  /<nama-file-program>/  (mis. /air-bersih/, /wesal-tv/)
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
import Progress from '../components/Progress.astro';
import ProgramCard from '../components/ProgramCard.astro';
import Icon from '../components/Icon.astro';
import { pilar, waLink, waLinkTo, type PilarKey } from '../data/site';
import { pilarVisual } from '../data/visual';

type Props =
  | { kind: 'kategori'; key: PilarKey; items: CollectionEntry<'program'>[] }
  | { kind: 'program'; entry: CollectionEntry<'program'>; related: CollectionEntry<'program'>[] };

export async function getStaticPaths() {
  const all = (await getCollection('program')).sort((a, b) => a.data.urutan - b.data.urutan);
  const kategori = (Object.keys(pilar) as PilarKey[]).map((key) => ({
    params: { slug: key },
    props: { kind: 'kategori' as const, key, items: all.filter((p) => p.data.pilar === key) },
  }));
  const programs = all.map((entry) => ({
    params: { slug: entry.id },
    props: {
      kind: 'program' as const,
      entry,
      related: all.filter((p) => p.id !== entry.id && p.data.pilar === entry.data.pilar).slice(0, 3),
    },
  }));
  return [...kategori, ...programs];
}

const props = Astro.props as Props;
const P = props.kind === 'program' ? props.entry.data : null;
const Content = props.kind === 'program' ? (await render(props.entry)).Content : null;
const isPsb = P?.status === 'PSB Dibuka';
const shareUrl = props.kind === 'program' ? new URL(`/${props.entry.id}/`, Astro.site).toString() : '';
---
{props.kind === 'kategori' ? (
  <Base title={`Program ${pilar[props.key].nama}`} description={pilar[props.key].lead}>
    <PageHero eyebrow="Program" title={`Program *${pilar[props.key].nama}*`} lead={pilar[props.key].lead}
      crumbs={[{ href: '/program/', label: 'Program' }]}>
      <p class="arab hero-ar" lang="ar" aria-hidden="true">{pilar[props.key].arab}</p>
    </PageHero>
    <section class="section-tight">
      <div class="container">
        <div class="grid">{props.items.map((p, i) => <ProgramCard entry={p} i={i % 3} />)}</div>

        {props.key === 'pendidikan' && (
          <aside class="callout on-plum textured" data-reveal>
            <div class="stack" style="--stack: var(--s-3)">
              <p class="eyebrow">Penerimaan Santri Baru</p>
              <h2 class="display">PSB TABS &amp; STAM <em>dibuka.</em></h2>
            </div>
            <a class="btn btn-light" href="/psb/">Info pendaftaran <Icon name="arrow-right" /></a>
          </aside>
        )}
        {props.key === 'sosial' && (
          <aside class="callout on-plum textured" data-reveal>
            <div class="stack" style="--stack: var(--s-3)">
              <p class="eyebrow">Program sosial lainnya</p>
              <h2 class="display">Ingin berbagi untuk <em>kebutuhan lain?</em></h2>
              <p class="muted">Santunan, bantuan darurat, dan kebutuhan mendesak lain dapat disalurkan melalui donasi program umum.</p>
            </div>
            <a class="btn btn-light" href="/donasi/">Donasi program umum <Icon name="arrow-right" /></a>
          </aside>
        )}
      </div>
    </section>
  </Base>
) : P && Content && props.kind === 'program' && (
  <Base title={P.title} description={P.ringkasan}>
    <PageHero eyebrow={`Program ${pilar[P.pilar].nama}`} title={P.title} lead={P.ringkasan}
      crumbs={[{ href: '/program/', label: 'Program' }, { href: pilar[P.pilar].href, label: pilar[P.pilar].nama }]}>
      {P.status && <span class:list={['status', { open: isPsb }]}>{P.status}</span>}
    </PageHero>

    <section class="section-tight">
      <div class="container layout">
        <div class="main">
          <Media image={P.foto} alt={P.fotoAlt || P.title} tone={pilarVisual[P.pilar].tone} emblem={P.ikon} ratio="16 / 10" label={P.title} eager sizes="(min-width: 960px) 60vw, 92vw" />
          <div class="prose" data-reveal><Content /></div>
        </div>

        <aside class="side" aria-label="Ringkasan program">
          <div class="panel" data-reveal>
            <span class="p-ic"><Icon name={P.ikon} /></span>
            <p class="serif p-title">{P.menu}</p>
            {P.target && P.terkumpul !== undefined && <Progress target={P.target} terkumpul={P.terkumpul} />}
            {(P.penerima || P.jadwal || P.lokasi) && (
              <dl class="facts">
                {P.penerima && <div><dt><Icon name="users" /> {P.pilar === 'pendidikan' ? 'Santri' : 'Capaian'}</dt><dd>{P.penerima}</dd></div>}
                {P.jadwal && <div><dt><Icon name="calendar" /> Waktu</dt><dd>{P.jadwal}</dd></div>}
                {P.lokasi && <div><dt><Icon name="map-pin" /> Lokasi</dt><dd>{P.lokasi}</dd></div>}
              </dl>
            )}
            {isPsb ? (
              <>
                <a class="btn full" href={P.wa ? waLinkTo(P.wa, `Assalamu’alaikum, saya ingin mendaftar PSB ${P.title}.`) : waLink(`Assalamu’alaikum, saya ingin mendaftar PSB ${P.title}.`)} target="_blank" rel="noopener"><Icon name="chat" /> Daftar via WhatsApp</a>
                <a class="btn btn-ghost full" href="/psb/">Info PSB</a>
              </>
            ) : P.pilar === 'pendidikan' && !P.donasi ? null : (
              <a class="btn full" href={`/donasi/?program=${props.entry.id}`}>{P.pilar === 'pendidikan' ? 'Dukung pesantren ini' : 'Dukung program ini'} <Icon name="arrow-right" /></a>
            )}
            <a class="link share" href={`https://wa.me/?text=${encodeURIComponent(`${P.title} — ${shareUrl}`)}`} target="_blank" rel="noopener"><Icon name="chat" /> Bagikan ke WhatsApp</a>
          </div>
        </aside>
      </div>
    </section>

    {props.related.length > 0 && (
      <section class="section bg-sand">
        <div class="container">
          <div class="rel-head">
            <h2 class="display" data-reveal>Program {pilar[P.pilar].nama.toLowerCase()} <em>lainnya</em></h2>
            <a href={pilar[P.pilar].href} class="link">Lihat semua <Icon name="arrow-right" /></a>
          </div>
          <div class="grid">{props.related.map((p, i) => <ProgramCard entry={p} i={i} />)}</div>
        </div>
      </section>
    )}
  </Base>
)}

<style>
  .hero-ar { position: absolute; right: 0; top: 0; font-size: clamp(3rem, 2rem + 6vw, 7rem); color: var(--rose); opacity: 0.18; line-height: 1; }
  .status { font-size: 0.8rem; font-weight: 650; padding: 0.35rem 0.85rem; border-radius: var(--r-pill); background: #fff; box-shadow: inset 0 0 0 1px var(--line-strong); }
  .status.open { background: var(--rose); color: #fff; box-shadow: none; }

  .grid { display: grid; gap: var(--s-6); }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .grid { grid-template-columns: repeat(3, 1fr); } }

  .callout { margin-top: var(--s-9); display: grid; gap: var(--s-5); align-items: end; padding: clamp(2rem, 1.5rem + 3vw, 3.5rem); border-radius: var(--r-lg); overflow: hidden; }
  .callout h2 { font-size: var(--step-3); max-width: 22ch; }
  @media (min-width: 960px) { .callout { grid-template-columns: 1fr auto; } }

  .layout { display: grid; gap: var(--s-8); align-items: start; padding-top: var(--s-4); }
  .main { display: grid; gap: var(--s-7); min-width: 0; }
  .panel { display: grid; gap: var(--s-4); padding: var(--s-6); border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-2); }
  .p-ic { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--grad-rose); color: #fff; }
  .p-title { font-size: 1.25rem; line-height: 1.3; }
  .facts { display: grid; gap: var(--s-3); padding-block: var(--s-4); border-block: 1px solid var(--line); }
  .facts div { display: grid; gap: 0.15rem; }
  .facts dt { display: inline-flex; align-items: center; gap: 0.45em; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .facts dt :global(.icon) { color: var(--rose); }
  .facts dd { font-weight: 560; }
  .full { width: 100%; }
  .share { justify-self: start; }
  @media (min-width: 960px) {
    .layout { grid-template-columns: minmax(0, 1fr) 21rem; gap: var(--s-8); }
    .side { position: sticky; top: 6.5rem; }
  }
  .rel-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-4); margin-bottom: var(--s-7); }
  .rel-head h2 { font-size: var(--step-3); }
</style>

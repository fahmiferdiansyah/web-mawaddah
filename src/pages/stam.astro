<script>
  type Wave = { no: number; label: string; end: string };
  const waves: Wave[] = JSON.parse(document.getElementById('stam-waves')?.textContent ?? '[]');
  const pad = (n: number) => String(n).padStart(2, '0');
  const $$ = <T extends HTMLElement>(s: string) => [...document.querySelectorAll<T>(s)];

  function tick() {
    const now = Date.now();
    const cur = waves.find((w) => new Date(w.end).getTime() > now);
    const idx = cur ? waves.indexOf(cur) : waves.length;

    // status tiap gelombang
    $$('[data-wave]').forEach((el) => {
      const i = Number(el.dataset.wave) - 1;
      el.classList.toggle('is-now', i === idx);
      el.classList.toggle('is-past', i < idx);
      const st = el.querySelector('[data-wave-status]');
      if (st) st.textContent = i < idx ? 'Telah ditutup' : i === idx ? 'Sedang dibuka' : 'Segera';
    });

    if (!cur) {
      $$('[data-wave-name]').forEach((e) => (e.textContent = 'Pendaftaran'));
      $$('[data-wave-label]').forEach((e) => (e.textContent = 'Seluruh gelombang telah ditutup, hubungi admin untuk info terbaru'));
      $$('[data-wave-label-2]').forEach((e) => (e.textContent = 'Hubungi admin untuk info gelombang berikutnya.'));
      $$('[data-countdown]').forEach((e) => (e.hidden = true));
      return;
    }

    const ms = Math.max(0, new Date(cur.end).getTime() - now);
    const d = Math.floor(ms / 864e5), h = Math.floor(ms / 36e5) % 24, m = Math.floor(ms / 6e4) % 60, s = Math.floor(ms / 1e3) % 60;
    const v: Record<string, string> = { d: pad(d), h: pad(h), m: pad(m), s: pad(s) };
    $$('[data-cd]').forEach((e) => (e.textContent = v[e.dataset.cd!]));

    $$('[data-wave-name]').forEach((e) => (e.textContent = `Gelombang ${cur.no}`));
    $$('[data-wave-date]').forEach((e) => (e.textContent = cur.label));
    $$('[data-wave-label]').forEach((e) => (e.textContent = `Gelombang ${cur.no} ditutup ${cur.label}`));
    $$('[data-wave-label-2]').forEach((e) => (e.textContent = `Gelombang ${cur.no} ditutup ${cur.label}.`));

    const left = d > 0 ? `${d} hari lagi` : h > 0 ? `${h} jam lagi` : 'hari terakhir';
    $$('[data-days-left]').forEach((e) => { e.hidden = false; e.textContent = `· ${left}`; });
    document.body.classList.toggle('is-hot', d < 4);
    $$('[data-mbar-text]').forEach((e) => (e.textContent = d < 4 ? `Daftar · ${left}` : 'Daftar STAM Sekarang'));
  }
  tick();
  let timer = window.setInterval(tick, 1000);
  document.addEventListener('visibilitychange', () => {
    window.clearInterval(timer);
    if (!document.hidden) { tick(); timer = window.setInterval(tick, 1000); }
  });

  // Bilah CTA seluler: muncul setelah hero lewat, hilang saat bagian biaya/penutup terlihat
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const hero = document.getElementById('atas');
  if (bar && hero && 'IntersectionObserver' in window) {
    let heroOut = false, ctaIn = false;
    const apply = () => bar.classList.toggle('is-on', heroOut && !ctaIn);
    new IntersectionObserver(([e]) => { heroOut = !e.isIntersecting; apply(); }).observe(hero);
    const io = new IntersectionObserver((es) => { ctaIn = es.some((e) => e.isIntersecting); apply(); });
    ['biaya', 'daftar'].forEach((id) => { const el = document.getElementById(id); if (el) io.observe(el); });
  }
</script>


  .s-chip { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.45rem 1rem; border-radius: 999px; background: rgb(224 196 138 / 0.12); border: 1px solid rgb(224 196 138 / 0.3); color: var(--gold-light); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em; line-height: 1.35; }
  .s-dot { flex: none; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--gold-light); }
  .s-h1 { margin-top: 1.4rem; font-size: clamp(2.6rem, 1.2rem + 5.6vw, 4.9rem); font-weight: 800; line-height: 1.02; letter-spacing: -0.035em; color: var(--cream); text-wrap: balance; }
  @media (min-width: 980px) { .s-h1 { white-space: nowrap; font-size: clamp(2.6rem, 0.5rem + 4.4vw, 4.6rem); } }
  .s-h1 em { display: block; font-family: var(--f-serif); font-style: italic; font-weight: 600; letter-spacing: -0.02em; color: var(--gold-light); }
  .s-hero-lead { margin-top: 1.5rem; max-width: 34rem; font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem); line-height: 1.65; color: #ddd8c4; }
  .s-hero-lead strong { color: var(--cream); }
  .s-cta-row { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2rem; }
  .s-cta-center { justify-content: center; }
  @media (max-width: 520px) { .s-cta-row .s-btn { width: 100%; } }
  .s-hero-points { margin-top: 1.75rem; display: grid; gap: 0.5rem; font-size: 0.95rem; color: #d3cdb4; list-style: none; padding: 0; }
  .s-hero-points li { display: flex; align-items: center; gap: 0.6rem; }
  .s-hero-points .icon { color: var(--gold-light); }

  /* Tiket hitung mundur */
  .s-ticket { background: var(--cream); color: var(--ink); border-radius: 1.75rem; padding: clamp(1.4rem, 1rem + 1.6vw, 2.1rem); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.65), 0 0 0 1px rgb(224 196 138 / 0.35); position: relative; }
  .s-ticket-kicker { display: flex; align-items: center; gap: 0.55rem; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--rust); }
  .s-live { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--rust); box-shadow: 0 0 0 0 rgb(180 83 42 / 0.6); animation: s-live 1.8s infinite; flex: none; }
  @keyframes s-live { 70% { box-shadow: 0 0 0 9px rgb(180 83 42 / 0); } 100% { box-shadow: 0 0 0 0 rgb(180 83 42 / 0); } }
  .s-cd { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.55rem; margin-top: 1rem; }
  .s-cd > div { background: var(--olive-deep); color: var(--cream); border-radius: 0.9rem; padding: 0.75rem 0.25rem 0.6rem; text-align: center; }
  .s-cd b { display: block; font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.5rem); line-height: 1; font-weight: 800; font-variant-numeric: tabular-nums; color: var(--gold-light); }
  .s-cd span { display: block; margin-top: 0.35rem; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: #c9c4ac; }
  .s-ticket-note { margin-top: 0.85rem; font-size: 0.9rem; color: var(--ink-soft); text-align: center; }
  .s-tear { border: 0; border-top: 2px dashed var(--sand-2); margin: 1.25rem 0; }
  .s-promo { text-align: center; }
  .s-promo-tag { font-size: 0.8rem; font-weight: 700; color: var(--gold-deep); letter-spacing: 0.03em; }
  .s-promo-price { margin-top: 0.35rem; display: flex; justify-content: center; align-items: baseline; flex-wrap: wrap; gap: 0.2rem 0.8rem; }
  .s-promo-price s { font-size: 1.05rem; color: var(--ink-soft); text-decoration-color: var(--rust); text-decoration-thickness: 2px; }
  .s-promo-price strong { font-size: clamp(2rem, 1.5rem + 1.8vw, 2.8rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .s-promo-save { display: inline-block; margin-top: 0.35rem; padding: 0.25rem 0.8rem; border-radius: 999px; background: #f4e1d8; color: var(--rust); font-weight: 700; font-size: 0.85rem; }
  .s-seats-mini { margin-block: 1.1rem 0.4rem; }
  .s-seats-cap { font-size: 0.85rem; color: var(--ink-soft); text-align: center; margin-bottom: 1.1rem; }
  .s-seats-cap b { color: var(--ink); }

  /* Kursi (titik logo) */
  .s-seats { display: grid; grid-template-columns: repeat(10, 1fr); gap: 0.45rem; max-width: 26rem; }
  .s-seats-mini { max-width: none; gap: 0.3rem; }
  .s-seat { display: block; aspect-ratio: 1; border-radius: 50%; }
  .s-seat-promo { background: var(--gold); box-shadow: 0 0 0 2px rgb(188 156 97 / 0.25); }
  .s-seat-reg { background: transparent; box-shadow: inset 0 0 0 2px var(--sage); }
  .s-seat-taken { background: #5b5e4d; box-shadow: none; opacity: 0.55; }
  .s-price .s-seat-reg { box-shadow: inset 0 0 0 2px #8d907d; }

  /* — Pita angka — */
  .s-ribbon { background: linear-gradient(180deg, var(--gold-light), #d7b977); color: var(--olive-deep); }
  .s-ribbon-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; padding-block: 1.75rem; }
  @media (min-width: 840px) { .s-ribbon-grid { grid-template-columns: repeat(4, 1fr); padding-block: 2.25rem; } }
  .s-ribbon-grid > div { padding-inline: 0.25rem; }
  .s-ribbon b { display: block; font-size: clamp(1.7rem, 1.2rem + 2vw, 2.75rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .s-ribbon-grid > div > span { display: block; margin-top: 0.3rem; font-size: 0.88rem; line-height: 1.4; color: #4a431f; }
  @media (min-width: 840px) { .s-ribbon-grid > div + div { border-left: 1px solid rgb(35 37 27 / 0.2); padding-left: 1.5rem; } }

  /* — Seksi umum — */
  .s-sec { padding-block: clamp(4rem, 2.5rem + 6vw, 8rem); }
  .s-sand { background: var(--sand); }
  .s-dark { background: linear-gradient(170deg, #2b2e22, #1f2118); color: var(--cream); }
  .s-head { max-width: 46rem; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .s-center { text-align: center; margin-inline: auto; }
  .s-kicker { display: inline-block; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-deep); }
  .s-kicker::before { content: ''; display: inline-block; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--gold); margin-right: 0.65rem; vertical-align: 0.05em; }
  .s-kicker-gold { color: var(--gold-light); }
  .s-h2 { margin-top: 0.9rem; font-size: clamp(2rem, 1.3rem + 2.9vw, 3.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.03em; color: var(--ink); text-wrap: balance; }
  .s-h2 em { font-family: var(--f-serif); font-style: italic; font-weight: 600; letter-spacing: -0.015em; color: var(--gold-deep); }
  .s-dark .s-h2, .s-final .s-h2 { color: var(--cream); }
  .s-dark .s-h2 em, .s-final .s-h2 em { color: var(--gold-light); }
  .s-lead { margin-top: 1.2rem; font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); line-height: 1.7; color: var(--ink-soft); max-width: 40rem; }
  .s-center .s-lead { margin-inline: auto; }
  .s-dark .s-lead, .s-final .s-lead { color: #d3cdb4; }
  .s-dark .s-lead strong, .s-final .s-lead strong { color: var(--cream); }
  .s-link { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.5rem; font-weight: 650; color: var(--gold-deep); border-bottom: 1.5px solid currentColor; padding-bottom: 0.15rem; }

  /* Masalah */
  .s-gaps { display: grid; gap: 1.25rem; }
  @media (min-width: 880px) { .s-gaps { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }
  .s-gap { position: relative; padding: 2rem 1.75rem 1.9rem; border-radius: 1.5rem 1.5rem 1.5rem 0.4rem; background: #fff; box-shadow: 0 1px 0 var(--line) inset, 0 18px 40px -26px rgb(35 37 27 / 0.35); border: 1px solid var(--line); overflow: hidden; }
  .s-gap-no { position: absolute; right: 1.2rem; top: 0.4rem; font-size: 4.2rem; font-weight: 800; letter-spacing: -0.04em; color: var(--sand-2); line-height: 1; }
  .s-gap h3 { position: relative; font-size: 1.3rem; font-weight: 700; line-height: 1.25; max-width: 14ch; color: var(--ink); }
  .s-gap p { position: relative; margin-top: 0.8rem; color: var(--ink-soft); line-height: 1.7; }
  .s-bridge { margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem); font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.1rem); font-weight: 700; letter-spacing: -0.02em; text-align: center; text-wrap: balance; }
  .s-bridge em { font-family: var(--f-serif); font-weight: 600; color: var(--gold-deep); }

  /* Bekal */
  .s-bekal { display: grid; gap: 1.25rem; }
  @media (min-width: 880px) { .s-bekal { grid-template-columns: repeat(3, 1fr); } }
  .s-card { padding: 2rem 1.75rem; border-radius: 1.75rem; background: var(--cream); border: 1px solid var(--line); box-shadow: 0 20px 44px -28px rgb(35 37 27 / 0.4); }
  .s-card h3 { margin-top: 1.1rem; font-size: 1.5rem; font-weight: 750; letter-spacing: -0.02em; }
  .s-card-sub { margin-top: 0.2rem; font-weight: 600; color: var(--gold-deep); font-size: 0.95rem; }
  .s-ico { display: grid; place-items: center; width: 3.4rem; height: 3.4rem; border-radius: 50%; background: var(--sage); color: var(--cream); }
  .s-ico .icon { width: 1.5rem; height: 1.5rem; }
  .s-ico-gold { background: var(--gold); color: var(--olive-deep); flex: none; }
  .s-list { list-style: none; padding: 0; margin-top: 1.1rem; display: grid; gap: 0.6rem; }
  .s-list li { position: relative; padding-left: 1.6rem; line-height: 1.55; color: var(--ink-soft); }
  .s-list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--gold); }
  .s-list-light li { color: #d9d4be; }
  .s-card-wide { margin-top: 1.25rem; display: grid; gap: 1.25rem; align-items: start; background: var(--olive); color: var(--cream); border-color: transparent; }
  @media (min-width: 720px) { .s-card-wide { grid-template-columns: auto 1fr; gap: 1.75rem; align-items: center; padding: 2rem 2.25rem; } }
  .s-card-wide h3 { margin-top: 0; color: var(--cream); }
  .s-card-wide p { margin-top: 0.5rem; color: #d3cdb4; line-height: 1.7; }

  /* Perjalanan */
  .s-path { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 1.5rem; font-weight: 700; font-size: clamp(0.78rem, 0.7rem + 0.5vw, 1rem); }
  .s-path span { padding: 0.9rem 1rem; text-align: center; line-height: 1.3; }
  .s-path-a { background: var(--sage); color: var(--cream); border-radius: 999px 0 0 999px; }
  .s-path-b { background: var(--gold); color: var(--olive-deep); border-radius: 0 999px 999px 0; }
  .s-years { display: grid; gap: 1.25rem; }
  @media (min-width: 840px) { .s-years { grid-template-columns: 1fr 1fr; } }
  .s-year { padding: 2rem; border-radius: 1.75rem; background: rgb(255 252 243 / 0.05); border: 1px solid rgb(224 196 138 / 0.22); }
  .s-year-b { background: rgb(188 156 97 / 0.1); border-color: rgb(224 196 138 / 0.4); }
  .s-year-no { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-light); }
  .s-year h3 { margin-top: 0.5rem; font-size: 1.55rem; font-weight: 750; letter-spacing: -0.02em; color: var(--cream); }

  /* Lulusan */
  .s-grid3 { display: grid; gap: 1.1rem; }
  @media (min-width: 680px) { .s-grid3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 980px) { .s-grid3 { grid-template-columns: repeat(3, 1fr); } }
  .s-mini { padding: 1.6rem 1.5rem; border-radius: 1.3rem; background: #fff; border: 1px solid var(--line); }
  .s-mini h3 { margin-top: 0.9rem; font-size: 1.15rem; font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; }
  .s-mini p { margin-top: 0.45rem; color: var(--ink-soft); line-height: 1.65; font-size: 0.97rem; }
  .s-tick { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 50%; background: var(--gold-light); color: var(--olive-deep); }
  .s-tick .icon { width: 1.05rem; height: 1.05rem; stroke-width: 2.4; }

  /* Fasilitas */
  .s-fas { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .s-fas { grid-template-columns: 1fr 1.1fr; gap: 4.5rem; } }
  .s-checks { list-style: none; padding: 0; margin-top: 1.75rem; display: grid; gap: 0.7rem; grid-template-columns: 1fr; }
  @media (min-width: 520px) { .s-checks { grid-template-columns: 1fr 1fr; } }
  .s-checks li { display: flex; align-items: center; gap: 0.65rem; font-weight: 560; }
  .s-checks .icon { color: var(--gold-deep); stroke-width: 2.4; }
  .s-photos { display: grid; grid-template-columns: 1.05fr 1fr; grid-template-rows: auto auto; gap: 0.9rem; }
  .s-ph { overflow: hidden; background: var(--sand-2); }
  .s-ph img { width: 100%; height: 100%; object-fit: cover; }
  .s-ph-a { grid-row: 1 / span 2; border-radius: 9rem 1.2rem 1.2rem 1.2rem; aspect-ratio: 3 / 4.3; }
  .s-ph-b { border-radius: 1.2rem 1.2rem 1.2rem 1.2rem; aspect-ratio: 4 / 3; }
  .s-ph-c { border-radius: 1.2rem 1.2rem 6rem 1.2rem; aspect-ratio: 4 / 3; }
  .s-ph-b img, .s-ph-c img { aspect-ratio: 4 / 3; }

  /* Cocok / belum */
  .s-fit { display: grid; gap: 1.25rem; }
  @media (min-width: 860px) { .s-fit { grid-template-columns: 1.15fr 0.85fr; } }
  .s-fit > div { padding: 2rem; border-radius: 1.75rem; }
  .s-fit h3 { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.01em; }
  .s-fit ul { list-style: none; padding: 0; margin-top: 1.2rem; display: grid; gap: 0.85rem; }
  .s-fit li { display: flex; gap: 0.75rem; line-height: 1.55; align-items: flex-start; }
  .s-fit li .icon { margin-top: 0.2em; stroke-width: 2.4; }
  .s-fit-yes { background: var(--olive); color: var(--cream); }
  .s-fit-yes h3 { color: var(--gold-light); }
  .s-fit-yes li .icon { color: var(--gold-light); }
  .s-fit-no { background: var(--sand); border: 1px solid var(--line); }
  .s-fit-no li { color: var(--ink-soft); }
  .s-fit-no li .icon { color: var(--rust); }
  .s-fit-no p { margin-top: 1.4rem; font-family: var(--f-serif); font-style: italic; color: var(--gold-deep); line-height: 1.55; }

  .s-parents { margin-top: 1.25rem; display: grid; gap: 1.75rem; padding: clamp(1.75rem, 1.2rem + 2vw, 3rem); border-radius: 1.75rem; background: var(--sage-deep); color: var(--cream); }
  @media (min-width: 900px) { .s-parents { grid-template-columns: 0.9fr 1.1fr; align-items: center; gap: 3rem; } }
  .s-parents h3 { margin-top: 0.7rem; font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); line-height: 1.2; font-weight: 750; letter-spacing: -0.02em; color: var(--cream); text-wrap: balance; }
  .s-parents ul { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .s-parents li { display: grid; grid-template-columns: auto 1fr; gap: 0.85rem; line-height: 1.55; color: #e5e1cf; }
  .s-parents li b { color: var(--cream); }
  .s-parents li .icon { width: 1.4rem; height: 1.4rem; margin-top: 0.1rem; color: var(--gold-light); }

  /* Biaya */
  .s-price { position: relative; overflow: clip; isolation: isolate; }
  .s-price-mark { position: absolute; z-index: -1; left: -10%; bottom: -18%; width: min(60vw, 40rem); height: auto; opacity: 0.05; pointer-events: none; }
  .s-price-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 980px) { .s-price-grid { grid-template-columns: 1fr 0.95fr; gap: 5rem; } }
  .s-price-copy .s-seats { margin-top: 2rem; }
  .s-legend { list-style: none; padding: 0; margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; font-size: 0.9rem; color: #d3cdb4; }
  .s-legend li { display: flex; align-items: center; gap: 0.5rem; }
  .s-legend .s-seat { width: 0.85rem; flex: none; }
  .s-hot { margin-top: 1.25rem; display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.5rem 1rem; border-radius: 999px; background: rgb(180 83 42 / 0.2); color: #f3c2ab; font-weight: 700; }
  .s-hot .s-live { background: #f08a61; }
  .s-bill { background: var(--cream); color: var(--ink); border-radius: 1.9rem; padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7), 0 0 0 1px rgb(224 196 138 / 0.4); }
  .s-bill-head { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-deep); }
  .s-bill dl { margin-top: 1rem; }
  .s-bill dl > div { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 1.05rem; border-bottom: 1px dashed var(--sand-2); }
  .s-bill dt { font-weight: 650; line-height: 1.3; }
  .s-bill dt small { display: block; margin-top: 0.2rem; font-weight: 500; font-size: 0.82rem; color: var(--ink-soft); }
  .s-bill dd { font-weight: 800; font-size: 1.15rem; letter-spacing: -0.02em; text-align: right; white-space: nowrap; }
  .s-bill-main dd { font-size: 1.7rem; color: var(--ink); }
  .s-bill-main dd s { display: block; font-size: 0.95rem; font-weight: 500; color: var(--ink-soft); text-decoration-color: var(--rust); text-decoration-thickness: 2px; }
  .s-save { margin-block: 1.1rem 1.25rem; padding: 0.75rem 1rem; border-radius: 0.9rem; background: #f4e1d8; color: #7c3318; font-size: 0.95rem; text-align: center; }
  .s-rek { margin-top: 1.4rem; font-size: 0.85rem; color: var(--ink-soft); }
  .s-copy { margin-top: 0.5rem; width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.85rem 1rem; text-align: left; border-radius: 1rem; background: var(--sand); border: 1px dashed var(--gold); color: var(--ink); transition: background 200ms; }
  .s-copy b { display: block; font-size: 1.05rem; letter-spacing: 0.02em; }
  .s-copy small { color: var(--ink-soft); font-size: 0.8rem; }
  .s-copy-l { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; color: var(--gold-deep); flex: none; }
  .s-copy.is-copied { background: #e6efd9; border-color: #7a9b4a; }
  @media (hover: hover) { .s-copy:hover { background: var(--sand-2); } }

  /* Alur */
  .s-steps { list-style: none; padding: 0; display: grid; gap: 1rem; counter-reset: s; }
  @media (min-width: 720px) { .s-steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .s-steps { grid-template-columns: repeat(5, 1fr); gap: 0.9rem; } }
  .s-step { padding: 1.6rem 1.3rem; border-radius: 1.4rem; background: var(--cream); border: 1px solid var(--line); position: relative; }
  .s-step-no { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--olive); color: var(--gold-light); font-weight: 800; font-size: 1.1rem; }
  .s-step h3 { margin-top: 1rem; font-size: 1.1rem; font-weight: 700; line-height: 1.25; }
  .s-step p { margin-top: 0.45rem; font-size: 0.93rem; line-height: 1.6; color: var(--ink-soft); }
  .s-waves { margin-top: clamp(2.5rem, 2rem + 2vw, 4rem); padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); border-radius: 1.75rem; background: #fff; border: 1px solid var(--line); }
  .s-waves h3 { font-size: 1.3rem; font-weight: 750; }
  .s-wave-list { margin-top: 1.1rem; display: grid; gap: 0.75rem; }
  @media (min-width: 760px) { .s-wave-list { grid-template-columns: repeat(3, 1fr); } }
  .s-wave { padding: 1.2rem 1.3rem; border-radius: 1.2rem; background: var(--sand); border: 1px solid var(--line); }
  .s-wave-n { font-weight: 800; font-size: 1.1rem; }
  .s-wave-d { color: var(--ink-soft); margin-top: 0.15rem; }
  .s-wave-s { display: inline-block; margin-top: 0.7rem; padding: 0.2rem 0.75rem; border-radius: 999px; font-size: 0.78rem; font-weight: 700; background: var(--sand-2); color: var(--ink-soft); }
  .s-wave.is-now { background: var(--olive); color: var(--cream); border-color: var(--olive); box-shadow: 0 20px 40px -24px rgb(35 37 27 / 0.7); }
  .s-wave.is-now .s-wave-d { color: #d3cdb4; }
  .s-wave.is-now .s-wave-s { background: var(--gold-light); color: var(--olive-deep); }
  .s-wave.is-past { opacity: 0.55; }

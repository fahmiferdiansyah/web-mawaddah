---
/**
 * Halaman pendaratan khusus STAM (Sekolah Tadrib Ad-Du'at Mawaddah) — /stam/
 * Tema: zaitun–emas–gading dari logo STAM. Semua angka biaya, kuota, dan gelombang
 * dibaca dari `stamInfo` di src/data/site.ts (satu tempat untuk memperbarui).
 */
import { Image } from 'astro:assets';
import '@fontsource-variable/lora/wght.css';
import '@fontsource-variable/lora/wght-italic.css';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { stamInfo, site, legalitas, waLinkTo } from '../data/site';

import lockupLight from '../assets/stam/lockup-light.webp';
import markLight from '../assets/stam/mark-light.webp';
import markDark from '../assets/stam/mark.webp';
import gedung from '../assets/foto/program/stam.png';
import masjid from '../assets/stam/masjid.webp';
import kelas from '../assets/stam/kelas.webp';

const { biaya, kuota, kuotaPromo, gelombang, admin } = stamInfo;
const rp = (n: number) => 'Rp' + n.toLocaleString('id-ID');
const hemat = biaya.uangMasukNormal - biaya.uangMasukPromo;
const perHari = Math.round(biaya.syahriyah / 30 / 1000);
const terisi = stamInfo.terisi === null ? null : Math.max(0, Math.min(kuota, stamInfo.terisi));
const sisaPromo = terisi === null ? null : Math.max(0, kuotaPromo - terisi);

const pesan = {
  tanya: 'Assalamu’alaikum Ustadz, saya ingin bertanya tentang pendaftaran STAM Angkatan 1.',
  daftar: 'Assalamu’alaikum Ustadz, saya ingin mendaftar STAM Angkatan 1. Mohon arahannya.',
};
const wa = (kind: keyof typeof pesan, i = 0) => waLinkTo(admin[i].wa, pesan[kind]);

const seats = Array.from({ length: kuota }, (_, i) => ({
  i,
  kind: terisi !== null && i < terisi ? 'taken' : i < kuotaPromo ? 'promo' : 'reg',
}));

const bekal = [
  { ikon: 'book', judul: 'Ilmu Syar’i', sub: 'Fondasi yang kokoh dan terarah', poin: ['Al-Qur’an & tahfizh, target minimal 5 juz mutqin', 'Aqidah & akhlak', 'Hadits dan fiqih', 'Bahasa Arab', 'Dasar-dasar dakwah'] },
  { ikon: 'sprout', judul: 'Jiwa Wirausaha', sub: 'Mandiri secara ekonomi', poin: ['Wawasan bisnis', 'Manajemen usaha', 'Manajemen keuangan', 'Keterampilan ekonomi mandiri'] },
  { ikon: 'star8', judul: 'Kepemimpinan', sub: 'Disiplin, ibadah, mentoring', poin: ['Pembinaan karakter & kedisiplinan', 'Mentoring berkelanjutan', 'Manajemen organisasi', 'Ceramah, khutbah & komunikasi umat'] },
] as const;

const celah = [
  { no: '01', judul: 'Ilmu yang belum terarah', teks: 'Semangat berdakwah besar, tetapi belajar sepotong-sepotong tanpa kurikulum dan pembimbing. Padahal dakwah menuntut fondasi aqidah, fiqih, dan bahasa Arab yang kokoh.' },
  { no: '02', judul: 'Memimpin tanpa bekal', teks: 'Da’i dituntut mengelola masjid, majelis, pendidikan, dan kegiatan sosial. Namun jarang ada yang dilatih memimpin dan menata organisasi sejak awal.' },
  { no: '03', judul: 'Dakwah yang bergantung', teks: 'Tanpa kemandirian ekonomi, dakwah berhenti ketika dukungan berhenti, dan marwah serta izzah seorang da’i ikut dipertaruhkan.' },
] as const;

const lulusan = [
  { judul: 'Berilmu secara terstruktur', teks: 'Dasar-dasar ilmu syar’i yang tertata rapi, bukan potongan-potongan pengetahuan.' },
  { judul: 'Dekat dengan Al-Qur’an', teks: 'Mampu membaca, menghafal, memahami, dan menjaga hafalan, dengan target minimal 5 juz mutqin.' },
  { judul: 'Berakhlak dan disiplin', teks: 'Karakter da’i yang bertanggung jawab dan mampu bekerja sama dalam tim.' },
  { judul: 'Terampil menyampaikan', teks: 'Ceramah, khutbah, mengajar, berkomunikasi dengan masyarakat, dan mengelola kegiatan dakwah.' },
  { judul: 'Siap memimpin dan berusaha', teks: 'Bekal manajemen organisasi, kepemimpinan, dan wawasan entrepreneurship untuk berdiri di atas kaki sendiri.' },
  { judul: 'Berpengalaman dan berjejaring', teks: 'Magang di lembaga nyata: masjid, pesantren, sekolah, lembaga dakwah, hingga dunia usaha.' },
] as const;

const fasilitas = ['Kelas & asrama ber-AC', 'Auditorium ber-AC', 'Masjid ber-AC milik sendiri', 'Gedung milik sendiri', 'Dapur milik sendiri', 'Ruang makan nyaman', 'Kamar mandi nyaman'];

const syarat = ['Khusus ikhwan', 'Lulusan SMA/MA/sederajat', 'Siap tinggal di asrama', 'Ijazah SMA/MA atau SKL', 'KTP & Kartu Keluarga', 'Pas foto berjas, latar merah', 'Surat keterangan sehat'];

const cocok = [
  'Lulusan SMA/MA/sederajat yang ingin menjadikan dakwah sebagai jalan hidup',
  'Ingin berdakwah dengan bekal ilmu, bukan hanya semangat',
  'Siap tinggal di asrama dan hidup disiplin selama 2 tahun',
  'Ingin mandiri secara ekonomi dan tidak menggantungkan dakwah pada orang lain',
  'Mau belajar memimpin dan berani turun langsung ke lapangan',
];
const belum = [
  'Belum siap berasrama atau terikat jadwal yang tertib',
  'Mencari jalan pintas tanpa proses belajar dan praktik',
  'Belum bersedia mengikuti seluruh rangkaian pendidikan selama 2 tahun',
];

const alur = [
  { judul: 'Isi formulir online', teks: 'Data diri, riwayat pendidikan, motivasi, dan unggah berkas, semuanya dari ponsel.' },
  { judul: 'Bayar pendaftaran', teks: `${rp(biaya.pendaftaran)} ke rekening resmi, lalu kirim bukti transfer ke admin.` },
  { judul: 'Seleksi administrasi', teks: 'Panitia memeriksa kelengkapan data dan berkas Anda.' },
  { judul: 'Ujian masuk', teks: 'Tiga tahap: ujian tertulis via Google Form, wawancara, dan tes wawasan keagamaan dasar.' },
  { judul: 'Daftar ulang & mulai belajar', teks: 'Lolos seleksi, lakukan daftar ulang, dan bergabung sebagai mahasantri angkatan pertama.' },
] as const;

const faq = [
  { q: 'Siapa yang boleh mendaftar?', a: 'Khusus ikhwan lulusan SMA/MA atau sederajat yang siap tinggal di asrama selama masa pendidikan.' },
  { q: 'Berapa biaya yang harus disiapkan?', a: `Biaya pendaftaran ${rp(biaya.pendaftaran)}. Uang masuk normal ${rp(biaya.uangMasukNormal)}, namun <strong>diskon 50% menjadi ${rp(biaya.uangMasukPromo)}</strong> khusus ${kuotaPromo} pendaftar pertama. Syahriyah ${rp(biaya.syahriyah)} per bulan.` },
  { q: 'Bagaimana cara mendaftar dan membayar?', a: `Isi <a href="/daftar-stam/">formulir pendaftaran online</a>, lalu transfer biaya pendaftaran ke <strong>BSI ${stamInfo.rekening}</strong> a.n. ${stamInfo.atasNama}. Kirim bukti transfer ke admin STAM melalui WhatsApp. Bayarlah hanya ke rekening resmi ini.` },
  { q: 'Apa saja yang dipelajari di STAM?', a: 'Tahun pertama: Al-Qur’an dan tahfizh (target minimal 5 juz mutqin), aqidah dan akhlak, hadits, fiqih, bahasa Arab, dakwah, leadership, entrepreneurship, manajemen organisasi, dan manajemen keuangan. Tahun kedua: praktik lapangan melalui magang di lembaga yang relevan.' },
  { q: 'Bagaimana ujian masuknya?', a: 'Ada tiga tahap: ujian tertulis (materi dasar SMA/MA, melalui Google Form), wawancara untuk menggali motivasi dan kesiapan, serta tes wawasan keagamaan dasar. Jadwal disampaikan panitia setelah seleksi administrasi.' },
  { q: 'Berkas apa yang perlu disiapkan?', a: 'Ijazah atau SKL SMA/MA, KTP, Kartu Keluarga, pas foto berjas latar merah, dan surat keterangan sehat (boleh menyusul bila belum ada).' },
  { q: 'Kapan pendaftaran ditutup?', a: `Gelombang 1 ditutup ${gelombang[0].label}, Gelombang 2 ${gelombang[1].label}, dan Gelombang 3 ${gelombang[2].label}. Kuota angkatan pertama hanya ${kuota} mahasantri, dan diskon uang masuk hanya untuk ${kuotaPromo} pendaftar pertama.` },
  { q: 'Apakah ada keringanan atau skema pembayaran?', a: 'Silakan sampaikan kondisi Anda langsung kepada admin STAM melalui WhatsApp. Ustadz akan menjelaskan ketentuan pembayaran yang berlaku.' },
  { q: 'Di mana lokasi STAM?', a: `STAM bertempat di Graha Mawaddah, ${stamInfo.alamat}. <a href="${stamInfo.peta}" target="_blank" rel="noopener">Buka di Google Maps</a>.` },
];

const strip = (h: string) => h.replace(/<[^>]+>/g, '');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Sekolah Tadrib Ad-Du’at Mawaddah (STAM)',
    alternateName: 'STAM',
    url: new URL('/stam/', Astro.site).toString(),
    logo: new URL('/icon-512.png', Astro.site).toString(),
    parentOrganization: { '@type': 'NGO', name: site.name },
    address: { '@type': 'PostalAddress', streetAddress: 'Jl. Swadaya I No. 59, Pondok Ranggon, Cipayung', addressLocality: 'Jakarta Timur', addressRegion: 'DKI Jakarta', postalCode: '13860', addressCountry: 'ID' },
    telephone: '+' + admin[0].wa,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })),
  },
];

const waves = gelombang.map((g) => ({ no: g.no, label: g.label, end: `${g.tutup}T23:59:59+07:00` }));
---
<Base
  bare
  bodyClass="stam"
  themeColor="#1f2118"
  title="Pendaftaran STAM Angkatan 1 Dibuka · Sekolah Tadrib Ad-Du’at Mawaddah"
  description={`Pendidikan da’i berasrama 2 tahun di Jakarta Timur: ilmu syar’i, kepemimpinan, dan wirausaha. Diskon 50% uang masuk untuk ${kuotaPromo} pendaftar pertama. Kuota hanya ${kuota} mahasantri.`}
  image="/og-stam.jpg"
>
  <Fragment slot="head">
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <script type="application/json" id="stam-waves" set:html={JSON.stringify(waves)} />
  </Fragment>

  <!-- Pita pengumuman -->
  <div class="s-announce" data-announce>
    <a href="#biaya" class="s-announce-in">
      <Icon name="clock" />
      <span><strong data-wave-label>Gelombang 1 ditutup {gelombang[0].label}</strong><span class="s-hide-sm"> · diskon 50% uang masuk untuk {kuotaPromo} pendaftar pertama</span></span>
      <span class="s-announce-left" data-days-left hidden></span>
      <Icon name="arrow-right" class="s-hide-sm" />
    </a>
  </div>

  <!-- Header -->
  <header class="s-header">
    <div class="s-wrap s-header-in">
      <a href="#atas" class="s-brand" aria-label="STAM — Sekolah Tadrib Ad-Du’at Mawaddah">
        <Image src={lockupLight} alt="Sekolah Tadrib Ad-Du’at Mawaddah" width={360} height={126} loading="eager" />
      </a>
      <nav class="s-nav" aria-label="Navigasi halaman">
        <a href="#bekal">Keunggulan</a>
        <a href="#kurikulum">Kurikulum</a>
        <a href="#biaya">Biaya</a>
        <a href="#alur">Alur</a>
        <a href="#faq">Tanya Jawab</a>
      </nav>
      <a class="s-btn s-btn-gold s-btn-sm" href="/daftar-stam/"><span>Daftar<span class="s-hide-sm"> Sekarang</span></span> <Icon name="arrow-right" /></a>
    </div>
  </header>

  <!-- HERO -->
  <section class="s-hero" id="atas">
    <Image class="s-hero-mark" src={markLight} alt="" aria-hidden="true" loading="eager" />
    <span class="s-orb s-orb-a" aria-hidden="true"></span>
    <span class="s-orb s-orb-b" aria-hidden="true"></span>
    <div class="s-wrap s-hero-grid">
      <div class="s-hero-copy">
        <p class="s-chip s-rise" style="--d:0ms"><span class="s-dot"></span> Penerimaan Mahasantri Baru · Angkatan Pertama · TA 2027/2028</p>
        <h1 class="s-h1 s-rise" style="--d:90ms">
          Ilmunya mumpuni.
          <em>Usahanya mandiri.</em>
        </h1>
        <p class="s-hero-lead s-rise" style="--d:180ms">
          Program kaderisasi da’i berasrama <strong>2 tahun</strong> di Jakarta Timur. Kuasai ilmu syar’i yang terarah, ditempa jiwa kepemimpinan, dan dibekali keterampilan usaha, agar kelak dakwahmu berdiri di atas kakimu sendiri.
        </p>
        <div class="s-cta-row s-rise" style="--d:270ms">
          <a class="s-btn s-btn-gold s-btn-lg s-pulse" href="/daftar-stam/">Amankan Kursi Angkatan Pertama <Icon name="arrow-right" /></a>
          <a class="s-btn s-btn-ghost s-btn-lg" href={wa('tanya')} target="_blank" rel="noopener"><Icon name="chat" /> Chat Ustadz</a>
        </div>
        <ul class="s-hero-points s-rise" style="--d:360ms">
          <li><Icon name="check" /> Khusus ikhwan lulusan SMA/MA/sederajat</li>
          <li><Icon name="check" /> Hanya {kuota} kursi untuk angkatan pertama</li>
          <li><Icon name="check" /> Daftar online, hanya {rp(biaya.pendaftaran)}</li>
        </ul>
      </div>

      <aside class="s-ticket s-rise" style="--d:300ms" aria-label="Hitung mundur pendaftaran">
        <p class="s-ticket-kicker"><span class="s-live"></span> <span data-wave-name>Gelombang 1</span> segera ditutup</p>
        <div class="s-cd" data-countdown role="timer" aria-live="off">
          <div><b data-cd="d">00</b><span>hari</span></div>
          <div><b data-cd="h">00</b><span>jam</span></div>
          <div><b data-cd="m">00</b><span>menit</span></div>
          <div><b data-cd="s">00</b><span>detik</span></div>
        </div>
        <p class="s-ticket-note">Ditutup <strong data-wave-date>{gelombang[0].label}</strong></p>
        <hr class="s-tear" />
        <div class="s-promo">
          <p class="s-promo-tag">Diskon 50% uang masuk · {kuotaPromo} pendaftar pertama</p>
          <p class="s-promo-price"><s>{rp(biaya.uangMasukNormal)}</s> <strong>{rp(biaya.uangMasukPromo)}</strong></p>
          <p class="s-promo-save">Hemat {rp(hemat)}</p>
        </div>
        <div class="s-seats s-seats-mini" aria-hidden="true">
          {seats.map((s) => <i class={`s-seat s-seat-${s.kind}`}></i>)}
        </div>
        <p class="s-seats-cap">
          {sisaPromo === null
            ? <><b>{kuotaPromo} kursi diskon</b> dari {kuota} kursi total</>
            : <>Sisa <b>{sisaPromo}</b> dari {kuotaPromo} kursi diskon</>}
        </p>
        <a class="s-btn s-btn-gold s-btn-block" href="/daftar-stam/">Daftar sebelum kehabisan <Icon name="arrow-right" /></a>
      </aside>
    </div>
  </section>

  <!-- PITA ANGKA -->
  <section class="s-ribbon" aria-label="Sekilas STAM">
    <div class="s-wrap s-ribbon-grid">
      <div><b class="count" data-count="2" data-suffix=" Tahun">2 Tahun</b><span>1 tahun ilmu, 1 tahun praktik</span></div>
      <div><b class="count" data-count={kuota}>{kuota}</b><span>kuota maksimal mahasantri</span></div>
      <div><b><span class="count" data-count="5">5</span> Juz</b><span>target minimal hafalan mutqin</span></div>
      <div><b>Rp<span class="count" data-count={hemat / 1_000_000} data-suffix=" Juta">{hemat / 1_000_000} Juta</span></b><span>hemat uang masuk, {kuotaPromo} pendaftar pertama</span></div>
    </div>
  </section>

  <!-- MASALAH -->
  <section class="s-sec" id="masalah">
    <div class="s-wrap">
      <header class="s-head" data-reveal>
        <p class="s-kicker">Mengapa STAM ada</p>
        <h2 class="s-h2">Niat berdakwah itu mulia. <em>Tetapi niat saja belum cukup.</em></h2>
        <p class="s-lead">Dakwah di tengah masyarakat membutuhkan kader yang bukan hanya paham agama, tetapi juga mampu memimpin dan berdiri mandiri. Tiga celah inilah yang sering menghentikan langkah para calon da’i.</p>
      </header>
      <div class="s-gaps">
        {celah.map((c, i) => (
          <article class="s-gap" data-reveal style={`--i:${i}`}>
            <span class="s-gap-no">{c.no}</span>
            <h3>{c.judul}</h3>
            <p>{c.teks}</p>
          </article>
        ))}
      </div>
      <p class="s-bridge" data-reveal>STAM dirancang untuk menutup <em>ketiga celah itu sekaligus</em>, dalam 2 tahun.</p>
    </div>
  </section>

  <!-- 3 BEKAL -->
  <section class="s-sec s-sand" id="bekal">
    <div class="s-wrap">
      <header class="s-head s-center" data-reveal>
        <p class="s-kicker">3 bekal utama</p>
        <h2 class="s-h2">Bukan sekadar menjadi da’i. <em>Menjadi da’i yang berilmu, mampu memimpin, dan mandiri.</em></h2>
      </header>
      <div class="s-bekal">
        {bekal.map((b, i) => (
          <article class="s-card" data-reveal style={`--i:${i}`}>
            <span class="s-ico"><Icon name={b.ikon} /></span>
            <h3>{b.judul}</h3>
            <p class="s-card-sub">{b.sub}</p>
            <ul class="s-list">{b.poin.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))}
      </div>
      <article class="s-card s-card-wide" data-reveal>
        <span class="s-ico s-ico-gold"><Icon name="mosque" /></span>
        <div>
          <h3>Plus: praktik lapangan sungguhan</h3>
          <p>Belajar langsung lewat magang dan kemitraan dengan lembaga independen yang terpercaya: masjid, pesantren, sekolah Islam, lembaga sosial dan dakwah, media dakwah, hingga unit usaha, lengkap dengan pembimbing, target kompetensi, laporan kegiatan, dan evaluasi akhir.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- KURIKULUM: 2 TAHUN -->
  <section class="s-sec s-dark" id="kurikulum">
    <div class="s-wrap">
      <header class="s-head" data-reveal>
        <p class="s-kicker s-kicker-gold">Perjalanan 2 tahun</p>
        <h2 class="s-h2">Dua tahun akan berlalu, <em>apa pun pilihanmu.</em></h2>
        <p class="s-lead">Pertanyaannya hanya satu: dua tahun ke depan kamu ingin menjadi siapa? Di STAM, setiap bulannya terarah, dari ruang kelas hingga lapangan dakwah.</p>
      </header>
      <div class="s-path" data-reveal aria-hidden="true">
        <span class="s-path-a">1 Tahun · Pendalaman Ilmu Syar’i</span>
        <span class="s-path-b">1 Tahun · Praktik Lapangan</span>
      </div>
      <div class="s-years">
        <article class="s-year" data-reveal>
          <p class="s-year-no">Tahun 1</p>
          <h3>Pendalaman ilmu & pembinaan intensif</h3>
          <ul class="s-list s-list-light">
            <li>Al-Qur’an dan tahfizh, target minimal 5 juz mutqin</li>
            <li>Aqidah & akhlak, hadits, fiqih, dan bahasa Arab</li>
            <li>Leadership dan pengembangan karakter</li>
            <li>Entrepreneurship, manajemen organisasi & industri, manajemen keuangan</li>
            <li>Keterampilan dakwah dan komunikasi</li>
          </ul>
        </article>
        <article class="s-year s-year-b" data-reveal style="--i:1">
          <p class="s-year-no">Tahun 2</p>
          <h3>Tadrib: praktik lapangan</h3>
          <ul class="s-list s-list-light">
            <li>Magang di masjid, pesantren, sekolah Islam, lembaga sosial & dakwah, media dakwah, atau unit usaha</li>
            <li>Dibimbing langsung oleh pembimbing lapangan</li>
            <li>Target kompetensi yang jelas dan terukur</li>
            <li>Laporan kegiatan dan evaluasi akhir</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- LULUSAN -->
  <section class="s-sec" id="lulusan">
    <div class="s-wrap">
      <header class="s-head" data-reveal>
        <p class="s-kicker">Setelah 2 tahun</p>
        <h2 class="s-h2">Lulusan STAM adalah da’i yang <em>siap diturunkan ke tengah umat.</em></h2>
      </header>
      <div class="s-grid3">
        {lulusan.map((l, i) => (
          <article class="s-mini" data-reveal style={`--i:${i % 3}`}>
            <span class="s-tick"><Icon name="check" /></span>
            <h3>{l.judul}</h3>
            <p>{l.teks}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FASILITAS -->
  <section class="s-sec s-sand" id="fasilitas">
    <div class="s-wrap s-fas">
      <div class="s-fas-copy" data-reveal>
        <p class="s-kicker">Fasilitas</p>
        <h2 class="s-h2">Tempat belajar yang <em>nyaman dan sepenuhnya milik sendiri.</em></h2>
        <p class="s-lead">Belajar, beribadah, makan, dan beristirahat dalam satu lingkungan di Graha Mawaddah, Pondok Ranggon, Jakarta Timur.</p>
        <ul class="s-checks">{fasilitas.map((f) => <li><Icon name="check" /> {f}</li>)}</ul>
        <a class="s-link" href={stamInfo.peta} target="_blank" rel="noopener"><Icon name="map-pin" /> Lihat lokasi di Google Maps</a>
      </div>
      <div class="s-photos" data-reveal style="--i:1">
        <figure class="s-ph s-ph-a"><Image src={gedung} alt="Gedung Graha Mawaddah tempat STAM" widths={[480, 800]} sizes="(min-width: 960px) 28rem, 90vw" /></figure>
        <figure class="s-ph s-ph-b"><Image src={masjid} alt="Ruang shalat di Graha Mawaddah" widths={[480, 800]} sizes="(min-width: 960px) 20rem, 60vw" /></figure>
        <figure class="s-ph s-ph-c"><Image src={kelas} alt="Ruang kelas STAM" widths={[480, 800]} sizes="(min-width: 960px) 20rem, 60vw" /></figure>
      </div>
    </div>
  </section>


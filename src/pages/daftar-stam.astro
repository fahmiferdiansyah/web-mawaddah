---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, waLink } from '../data/site';

// Kunci publishable Supabase aman ditaruh di sisi klien: tabel dikunci RLS,
// publik hanya bisa memanggil fungsi daftar_stam() (kirim data, tidak bisa membaca).
const SUPABASE_URL = 'https://ggnsloyuiclkegxjwsnz.supabase.co';
const SUPABASE_KEY = 'sb_publishable_rcsfU4R75dJYwdQNSs7jwA_-lSAepLQ';

const jenjang = [
  { k: 'sd', l: 'SD/MI' },
  { k: 'smp', l: 'SMP/MTs' },
  { k: 'sma', l: 'SMA/MA/Sederajat' },
  { k: 'pesantren', l: 'Pesantren/Ma’had (jika ada)' },
];
const komitmen = [
  'Bersedia mengikuti seluruh rangkaian pendidikan STAM selama 2 tahun.',
  'Bersedia mengikuti pembelajaran ilmu-ilmu syar’i dan program tahfizh Al-Qur’an.',
  'Bersedia mengikuti pembinaan leadership dan entrepreneurship.',
  'Bersedia mengikuti praktik lapangan pada lembaga yang ditentukan.',
  'Bersedia menaati seluruh tata tertib dan ketentuan STAM.',
  'Bersedia mengikuti seluruh proses pendidikan dengan sungguh-sungguh.',
];
const dokumen = ['Fotokopi KTP/Kartu Identitas', 'Fotokopi Kartu Keluarga', 'Fotokopi Ijazah/SKL terakhir', 'Pas Foto', 'Surat Keterangan Sehat', 'Dokumen pendukung lainnya'];
const minat = ['Dakwah', 'Pendidikan', 'Tahfizh Al-Qur’an', 'Leadership', 'Entrepreneurship', 'Manajemen', 'Sosial Kemasyarakatan'];
---
<Base title="Formulir Pendaftaran STAM Angkatan 1" description="Formulir pendaftaran online Sekolah Tadrib Ad Du’at Mawaddah (STAM) Angkatan ke-1 Tahun Ajaran 2027/2028." >
  <PageHero eyebrow="PMB STAM · Angkatan ke-1 · 2027/2028" title="Formulir pendaftaran *STAM.*"
    lead="Mempersiapkan kader da’i yang kompeten dalam bidang dakwah dan berjiwa leadership entrepreneurship. Isi data dengan benar; data Anda langsung diterima panitia."
    crumbs={[{ href: '/psb/', label: 'PSB & PMB' }, { href: '/stam/', label: 'STAM' }]} />

  <section class="section-tight">
    <div class="container narrow">
      <form id="form-stam" novalidate class="form" autocomplete="on">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />

        <fieldset>
          <legend>A. Data diri calon mahasantri</legend>
          <div class="g2">
            <div class="field"><label for="nama_lengkap">Nama lengkap <span class="req">*</span></label><input class="input" id="nama_lengkap" name="nama_lengkap" required autocomplete="name" /></div>
            <div class="field"><label for="nama_panggilan">Nama panggilan</label><input class="input" id="nama_panggilan" name="nama_panggilan" /></div>
            <div class="field"><label for="tempat_lahir">Tempat lahir <span class="req">*</span></label><input class="input" id="tempat_lahir" name="tempat_lahir" required /></div>
            <div class="field"><label for="tanggal_lahir">Tanggal lahir <span class="req">*</span></label><input class="input" type="date" id="tanggal_lahir" name="tanggal_lahir" required /></div>
            <div class="field"><span class="label">Jenis kelamin <span class="req">*</span></span>
              <div class="opts"><label><input type="radio" name="jenis_kelamin" value="Laki-laki" required /> Laki-laki</label></div></div>
            <div class="field"><span class="label">Status pernikahan <span class="req">*</span></span>
              <div class="opts"><label><input type="radio" name="status_nikah" value="Belum Menikah" required /> Belum Menikah</label><label><input type="radio" name="status_nikah" value="Menikah" /> Menikah</label></div></div>
            <div class="field"><label for="nik">NIK <span class="req">*</span></label><input class="input" id="nik" name="nik" inputmode="numeric" maxlength="16" required /><span class="hint">16 digit sesuai KTP.</span></div>
            <div class="field"><label for="nomor_kk">Nomor KK <span class="req">*</span></label><input class="input" id="nomor_kk" name="nomor_kk" inputmode="numeric" maxlength="16" required /><span class="hint">16 digit sesuai Kartu Keluarga.</span></div>
          </div>
          <div class="field"><label for="alamat">Alamat lengkap <span class="req">*</span></label><textarea class="input" id="alamat" name="alamat" rows="3" required></textarea></div>
          <div class="g2">
            <div class="field"><label for="desa">Desa/Kelurahan</label><input class="input" id="desa" name="desa" /></div>
            <div class="field"><label for="kecamatan">Kecamatan</label><input class="input" id="kecamatan" name="kecamatan" /></div>
            <div class="field"><label for="kota">Kota/Kabupaten <span class="req">*</span></label><input class="input" id="kota" name="kota" required /></div>
            <div class="field"><label for="provinsi">Provinsi <span class="req">*</span></label><input class="input" id="provinsi" name="provinsi" required /></div>
            <div class="field"><label for="kode_pos">Kode pos</label><input class="input" id="kode_pos" name="kode_pos" inputmode="numeric" maxlength="5" /></div>
            <div class="field"><label for="whatsapp">Nomor WhatsApp <span class="req">*</span></label><input class="input" id="whatsapp" name="whatsapp" type="tel" inputmode="tel" required autocomplete="tel" placeholder="08xxxxxxxxxx" /></div>
            <div class="field"><label for="email">Email</label><input class="input" id="email" name="email" type="email" autocomplete="email" /></div>
          </div>
        </fieldset>

        <fieldset>
          <legend>B. Riwayat pendidikan</legend>
          {jenjang.map((j) => (
            <div class="g2 row">
              <div class="field"><label for={`pd_${j.k}_lembaga`}>{j.l} — nama lembaga</label><input class="input" id={`pd_${j.k}_lembaga`} name={`pd_${j.k}_lembaga`} /></div>
              <div class="field"><label for={`pd_${j.k}_tahun`}>Tahun lulus</label><input class="input" id={`pd_${j.k}_tahun`} name={`pd_${j.k}_tahun`} inputmode="numeric" maxlength="4" /></div>
            </div>
          ))}
          <div class="field"><span class="label">Pendidikan terakhir <span class="req">*</span></span>
            <div class="opts">{['SMA', 'MA', 'SMK', 'Pesantren', 'Lainnya'].map((v, i) => <label><input type="radio" name="pendidikan_terakhir" value={v} required={i === 0} /> {v}</label>)}</div></div>
        </fieldset>

        <fieldset>
          <legend>C. Kemampuan keagamaan</legend>
          <div class="field"><span class="label">Kemampuan membaca Al-Qur’an <span class="req">*</span></span>
            <div class="opts">{['Sangat Baik', 'Baik', 'Cukup', 'Perlu Bimbingan'].map((v, i) => <label><input type="radio" name="baca_quran" value={v} required={i === 0} /> {v}</label>)}</div></div>
          <div class="g2">
            <div class="field"><label for="hafalan_juz">Jumlah hafalan saat ini (juz)</label><input class="input" id="hafalan_juz" name="hafalan_juz" inputmode="decimal" /></div>
            <div class="field"><span class="label">Kemampuan Bahasa Arab <span class="req">*</span></span>
              <div class="opts">{['Baik', 'Cukup', 'Dasar', 'Belum Bisa'].map((v, i) => <label><input type="radio" name="bahasa_arab" value={v} required={i === 0} /> {v}</label>)}</div></div>
          </div>
          <div class="field"><span class="label">Pernah mengikuti pendidikan/kajian keislaman?</span>
            <div class="opts"><label><input type="radio" name="pernah_kajian" value="Ya" /> Ya</label><label><input type="radio" name="pernah_kajian" value="Tidak" /> Tidak</label></div>
            <textarea class="input" name="kajian_ket" rows="2" placeholder="Jika ya, jelaskan"></textarea></div>
          <div class="field"><span class="label">Pernah mengikuti kegiatan dakwah?</span>
            <div class="opts"><label><input type="radio" name="pernah_dakwah" value="Ya" /> Ya</label><label><input type="radio" name="pernah_dakwah" value="Tidak" /> Tidak</label></div>
            <textarea class="input" name="dakwah_ket" rows="2" placeholder="Jika ya, bentuk kegiatan"></textarea></div>
        </fieldset>

        <fieldset>
          <legend>D. Data orang tua/wali</legend>
          <p class="sub">Ayah/Wali</p>
          <div class="g2">
            <div class="field"><label for="ayah_nama">Nama <span class="req">*</span></label><input class="input" id="ayah_nama" name="ayah_nama" required /></div>
            <div class="field"><label for="ayah_pekerjaan">Pekerjaan</label><input class="input" id="ayah_pekerjaan" name="ayah_pekerjaan" /></div>
            <div class="field"><label for="ayah_wa">No. WhatsApp <span class="req">*</span></label><input class="input" id="ayah_wa" name="ayah_wa" type="tel" inputmode="tel" required /></div>
          </div>
          <div class="field"><label for="ayah_alamat">Alamat</label><textarea class="input" id="ayah_alamat" name="ayah_alamat" rows="2"></textarea></div>
          <p class="sub">Ibu/Wali</p>
          <div class="g2">
            <div class="field"><label for="ibu_nama">Nama</label><input class="input" id="ibu_nama" name="ibu_nama" /></div>
            <div class="field"><label for="ibu_pekerjaan">Pekerjaan</label><input class="input" id="ibu_pekerjaan" name="ibu_pekerjaan" /></div>
            <div class="field"><label for="ibu_wa">No. WhatsApp</label><input class="input" id="ibu_wa" name="ibu_wa" type="tel" inputmode="tel" /></div>
          </div>
        </fieldset>

        <fieldset>
          <legend>E. Minat dan motivasi</legend>
          <div class="field"><label for="alasan">Apa alasan Anda ingin mengikuti pendidikan di STAM? <span class="req">*</span></label><textarea class="input" id="alasan" name="alasan" rows="4" required></textarea></div>
          <div class="field"><label for="harapan">Apa yang Anda harapkan setelah menyelesaikan pendidikan di STAM? <span class="req">*</span></label><textarea class="input" id="harapan" name="harapan" rows="4" required></textarea></div>
          <div class="field"><span class="label">Bidang yang paling diminati</span>
            <div class="opts">{minat.map((v) => <label><input type="checkbox" name="minat" value={v} /> {v}</label>)}</div>
            <input class="input" name="minat_lain" placeholder="Lainnya (tulis di sini)" /></div>
        </fieldset>

        <fieldset>
          <legend>F. Komitmen calon mahasantri</legend>
          <p class="sub">Saya menyatakan bahwa:</p>
          <div class="opts col">{komitmen.map((k) => <label><input type="checkbox" name="komitmen" required /> {k}</label>)}</div>
        </fieldset>

        <fieldset>
          <legend>G. Dokumen persyaratan</legend>
          <p class="hint">Centang berkas yang sudah Anda siapkan. Berkas dikirim ke panitia melalui WhatsApp setelah formulir terkirim.</p>
          <div class="opts col">{dokumen.map((d) => <label><input type="checkbox" name="dokumen" value={d} /> {d}</label>)}</div>
        </fieldset>

        <fieldset>
          <legend>H. Pernyataan</legend>
          <p>Dengan mengisi formulir ini, saya menyatakan bahwa seluruh data yang saya berikan adalah benar dan dapat dipertanggungjawabkan. Saya bersedia mengikuti seluruh proses seleksi dan ketentuan pendidikan Sekolah Tadrib Ad-Du’at Mawaddah Indonesia (STAM) Angkatan Ke-1 Tahun Ajaran 2027/2028.</p>
          <label class="opts"><input type="checkbox" name="pernyataan" required /> Saya menyetujui pernyataan di atas. <span class="req">*</span></label>
        </fieldset>

        <p id="form-error" class="error-text" role="alert" hidden></p>
        <button class="btn" type="submit" id="kirim"><Icon name="arrow-right" /> Kirim pendaftaran</button>
        <p class="hint">Data hanya digunakan panitia STAM untuk proses seleksi. Ada kendala? <a class="link" href={waLink('Assalamu’alaikum, saya mengalami kendala mengisi formulir pendaftaran STAM.')} target="_blank" rel="noopener">Hubungi admin</a> ({site.phone}).</p>
      </form>

      <div id="sukses" class="done" hidden tabindex="-1">
        <span class="ok"><Icon name="heart" /></span>
        <h2 class="display">Alhamdulillah, pendaftaran terkirim.</h2>
        <p>Nomor pendaftaran Anda:</p>
        <p class="nomor serif" id="nomor"></p>
        <p>Simpan nomor ini. Panitia akan menghubungi Anda melalui WhatsApp. Kirimkan berkas persyaratan dengan menyebut nomor pendaftaran.</p>
        <a class="btn" id="wa-konfirmasi" href="#" target="_blank" rel="noopener"><Icon name="chat" /> Kirim berkas via WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY, WA: site.whatsapp }}>
  (function () {
    var form = document.getElementById('form-stam');
    var err = document.getElementById('form-error');
    var btn = document.getElementById('kirim');
    var $ = function (n) { return form.elements[n]; };
    var val = function (n) { return ($(n) && $(n).value || '').trim(); };
    var radio = function (n) { var r = form.querySelector('input[name="' + n + '"]:checked'); return r ? r.value : ''; };
    var checks = function (n) { return Array.prototype.map.call(form.querySelectorAll('input[name="' + n + '"]:checked'), function (c) { return c.value; }); };

    function fail(msg, el) { err.textContent = msg; err.hidden = false; if (el) { el.setAttribute('aria-invalid', 'true'); el.focus(); } else err.scrollIntoView({ block: 'center' }); }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      err.hidden = true;
      form.querySelectorAll('[aria-invalid]').forEach(function (x) { x.removeAttribute('aria-invalid'); });
      var bad = form.querySelector('input[required]:not([type=radio]):not([type=checkbox]), textarea[required]');
      var reqs = form.querySelectorAll('input[required]:not([type=radio]):not([type=checkbox]), textarea[required]');
      for (var i = 0; i < reqs.length; i++) if (!reqs[i].value.trim()) return fail('Mohon lengkapi kolom bertanda *.', reqs[i]);
      var radios = {}; form.querySelectorAll('input[type=radio][required]').forEach(function (r) { radios[r.name] = 1; });
      for (var n in radios) if (!radio(n)) return fail('Mohon pilih salah satu pilihan yang bertanda *.', form.querySelector('input[name="' + n + '"]'));
      if (!/^\d{16}$/.test(val('nik'))) return fail('NIK harus 16 digit angka.', $('nik'));
      if (!/^\d{16}$/.test(val('nomor_kk'))) return fail('Nomor KK harus 16 digit angka.', $('nomor_kk'));
      if (val('whatsapp').replace(/\D/g, '').length < 9) return fail('Nomor WhatsApp belum valid.', $('whatsapp'));
      var kom = form.querySelectorAll('input[name=komitmen]');
      for (var k = 0; k < kom.length; k++) if (!kom[k].checked) return fail('Seluruh komitmen pada bagian F harus disetujui.', kom[k]);
      if (!$('pernyataan').checked) return fail('Pernyataan pada bagian H harus disetujui.', $('pernyataan'));

      var pend = {};
      ['sd', 'smp', 'sma', 'pesantren'].forEach(function (j) { pend[j] = { lembaga: val('pd_' + j + '_lembaga'), tahun: val('pd_' + j + '_tahun') }; });
      var payload = {
        website: val('website'),
        nama_lengkap: val('nama_lengkap'), nama_panggilan: val('nama_panggilan'), tempat_lahir: val('tempat_lahir'), tanggal_lahir: val('tanggal_lahir'),
        jenis_kelamin: radio('jenis_kelamin'), status_nikah: radio('status_nikah'), nik: val('nik'), nomor_kk: val('nomor_kk'),
        alamat: val('alamat'), desa: val('desa'), kecamatan: val('kecamatan'), kota: val('kota'), provinsi: val('provinsi'), kode_pos: val('kode_pos'),
        whatsapp: val('whatsapp'), email: val('email'),
        pendidikan: pend, pendidikan_terakhir: radio('pendidikan_terakhir'),
        kemampuan: { baca_quran: radio('baca_quran'), hafalan_juz: val('hafalan_juz'), bahasa_arab: radio('bahasa_arab'),
          pernah_kajian: radio('pernah_kajian'), kajian_ket: val('kajian_ket'), pernah_dakwah: radio('pernah_dakwah'), dakwah_ket: val('dakwah_ket') },
        orang_tua: { ayah: { nama: val('ayah_nama'), pekerjaan: val('ayah_pekerjaan'), wa: val('ayah_wa'), alamat: val('ayah_alamat') },
          ibu: { nama: val('ibu_nama'), pekerjaan: val('ibu_pekerjaan'), wa: val('ibu_wa') } },
        motivasi: { alasan: val('alasan'), harapan: val('harapan'), minat: checks('minat'), minat_lain: val('minat_lain') },
        komitmen_setuju: true, dokumen: checks('dokumen'), pernyataan_setuju: true
      };

      btn.disabled = true; btn.setAttribute('aria-busy', 'true');
      fetch(SUPABASE_URL + '/rest/v1/rpc/daftar_stam', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY },
        body: JSON.stringify({ p: payload })
      }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          if (!res.ok) {
            var m = (res.j && res.j.message) || '';
            return fail(/sudah terdaftar/.test(m) ? 'NIK ini sudah terdaftar. Jika merasa belum mendaftar, hubungi admin.' : 'Pendaftaran belum terkirim. Periksa data lalu coba lagi, atau hubungi admin.', null);
          }
          document.getElementById('nomor').textContent = res.j;
          document.getElementById('wa-konfirmasi').href = 'https://wa.me/' + WA + '?text=' + encodeURIComponent('Assalamu’alaikum, saya telah mendaftar STAM dengan nomor pendaftaran ' + res.j + ' a.n. ' + payload.nama_lengkap + '. Berikut berkas persyaratan saya.');
          form.hidden = true;
          var s = document.getElementById('sukses'); s.hidden = false; s.focus(); window.scrollTo({ top: 0, behavior: 'smooth' });
        })
        .catch(function () { fail('Koneksi bermasalah. Periksa internet Anda lalu coba lagi.', null); })
        .finally(function () { btn.disabled = false; btn.removeAttribute('aria-busy'); });
    });
  })();
</script>

<style>
  .narrow { max-width: 52rem; }
  .form { display: grid; gap: var(--s-6); }
  fieldset { display: grid; gap: var(--s-4); margin: 0; padding: var(--s-6); border: 0; border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-1); min-width: 0; }
  legend { float: left; width: 100%; padding: 0; margin-bottom: var(--s-2); font-weight: 700; font-size: 1.2rem; color: var(--rose); }
  fieldset > legend + * { clear: both; }
  .g2 { display: grid; gap: var(--s-4); }
  @media (min-width: 640px) { .g2 { grid-template-columns: 1fr 1fr; } }
  .opts { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .opts.col { flex-direction: column; }
  .opts label { display: inline-flex; align-items: flex-start; gap: 0.55rem; font-weight: 450; }
  .opts input { width: 1.15rem; height: 1.15rem; margin-top: 0.2rem; accent-color: var(--rose); flex: none; }
  .sub { font-weight: 650; margin: 0; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .done { display: grid; gap: var(--s-4); justify-items: start; padding: var(--s-7); border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-2); outline: none; }
  .done[hidden], .form[hidden] { display: none; }
  .ok { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--grad-rose); color: #fff; }
  .nomor { font-size: var(--step-3); font-weight: 700; letter-spacing: 0.04em; }
</style>

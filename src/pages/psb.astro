---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Media from '../components/Media.astro';
import ProgramCard from '../components/ProgramCard.astro';
import Icon from '../components/Icon.astro';
import { site, waLink } from '../data/site';

const tabs = (await getCollection('program', (p) => p.data.pilar === 'pendidikan' && (p.id.startsWith('tabs-') || p.id === 'stam'))).sort((a, b) => a.data.urutan - b.data.urutan);
const dibuka = tabs.filter((t) => t.data.status === 'PSB Dibuka');
const berjalan = tabs.filter((t) => t.data.status !== 'PSB Dibuka');

// [PLACEHOLDER] Alur umum — sesuaikan dengan ketentuan panitia PSB
const alur = [
  { t: 'Hubungi admin PSB', d: 'Tanyakan brosur, persyaratan, dan rincian biaya melalui WhatsApp.' },
  { t: 'Isi formulir pendaftaran', d: 'Lengkapi data calon santri dan berkas yang diminta panitia.' },
  { t: 'Tes & wawancara', d: 'Calon santri mengikuti tes bacaan Al-Qur’an dan wawancara bersama orang tua.' },
  { t: 'Pengumuman & daftar ulang', d: 'Calon santri yang diterima melakukan daftar ulang dan bersiap masuk asrama.' },
];
---
<Base title="Penerimaan Santri Baru" description="PSB TABS 4 Cilacap, TABS 5 Cianjur, dan STAM (Sekolah Tadrib Ad Du’at Mawaddah) telah dibuka. Daftar melalui WhatsApp admin Yayasan Mawaddah Indonesia.">
  <PageHero eyebrow="Penerimaan Santri Baru" title="TABS dan STAM *membuka PSB.*"
    lead="Pendaftaran kini dibuka untuk TABS 4 Cilacap, TABS 5 Cianjur, dan STAM — program kaderisasi da’i di Graha Mawaddah."
    crumbs={[{ href: '/pendidikan/', label: 'Pendidikan' }]}>
    <div class="cluster" data-reveal style="--i:4">
      <a class="btn" href={waLink('Assalamu’alaikum, saya ingin mendaftar PSB TABS / STAM Yayasan Mawaddah.')} target="_blank" rel="noopener"><Icon name="chat" /> Daftar via WhatsApp</a>
      <a class="btn btn-ghost" href="#alur">Lihat alur pendaftaran</a>
    </div>
  </PageHero>

  <section class="section-tight">
    <div class="container open-grid">
      {dibuka.map((t, i) => (
        <article class="open-card" data-reveal style={`--i:${i}`}>
          <Media shape="arch" tone={i % 2 === 0 ? 'rose' : 'plum'} emblem="cap" ratio="4 / 5" alt={t.data.fotoAlt || t.data.title} image={t.data.foto} label={t.data.menu} class="oc-media" sizes="(min-width: 960px) 20vw, 40vw" />
          <div class="oc-body">
            <span class="badge-open">PSB Dibuka</span>
            <h2 class="display oc-title">{t.data.menu}</h2>
            <p class="muted">{t.data.ringkasan}</p>
            <p class="oc-loc small"><Icon name="map-pin" /> {t.data.lokasi}</p>
            <div class="cluster">
              <a class="btn btn-sm" href={waLink(`Assalamu’alaikum, saya ingin mendaftar PSB ${t.data.title}.`)} target="_blank" rel="noopener">Daftar</a>
              <a class="link small" href={`/${t.id}/`}>Profil pesantren <Icon name="arrow-right" /></a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="alur" class="section" aria-labelledby="alur-title">
    <div class="container">
      <SectionHead eyebrow="Alur pendaftaran" id="alur-title" title="Empat langkah *menuju pendaftaran.*" align="split"
        lead="Alur umum pendaftaran. Ketentuan lengkap, jadwal, dan biaya akan dikirimkan oleh admin PSB." />
      <ol class="alur">
        {alur.map((a, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="step serif">{i + 1}</span>
            <h3>{a.t}</h3>
            <p class="muted">{a.d}</p>
          </li>
        ))}
      </ol>
      <aside class="help on-plum textured" data-reveal>
        <div>
          <p class="eyebrow">Admin PSB</p>
          <p class="display help-title">Ada pertanyaan? Hubungi <em>{site.phone}</em></p>
        </div>
        <a class="btn btn-light" href={waLink('Assalamu’alaikum, saya ingin bertanya tentang PSB Taisiru Ar-Rahman Boarding School.')} target="_blank" rel="noopener"><Icon name="chat" /> Chat admin</a>
      </aside>
    </div>
  </section>

  <section class="section bg-sand" aria-labelledby="tabs-title">
    <div class="container">
      <SectionHead eyebrow="Pesantren yang berjalan" id="tabs-title" title="Keluarga besar *Taisiru Ar-Rahman.*" />
      <div class="grid">{berjalan.map((p, i) => <ProgramCard entry={p} i={i} />)}</div>
    </div>
  </section>
</Base>

<style>
  .open-grid { display: grid; gap: var(--s-5); }
  @media (min-width: 960px) { .open-grid { grid-template-columns: 1fr 1fr; } }
  .open-card { display: grid; grid-template-columns: minmax(7rem, 0.7fr) 1fr; gap: var(--s-5); align-items: center; padding: var(--s-5); border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-2); }
  @media (max-width: 520px) { .open-card { grid-template-columns: 1fr; } .open-card :global(.oc-media) { width: 60%; justify-self: center; } }
  .oc-body { display: grid; gap: var(--s-3); justify-items: start; }
  .badge-open { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; padding: 0.3rem 0.75rem; border-radius: var(--r-pill); background: var(--rose); color: #fff; }
  .oc-title { font-size: var(--step-3); }
  .oc-loc { display: inline-flex; align-items: center; gap: 0.4em; font-weight: 560; }
  .oc-loc :global(.icon) { color: var(--rose); }

  .alur { list-style: none; padding: 0; display: grid; gap: var(--s-4); counter-reset: a; }
  .alur li { position: relative; display: grid; gap: var(--s-2); align-content: start; padding: var(--s-6) var(--s-5) var(--s-5); border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-1); }
  .step { display: grid; place-items: center; width: 3rem; height: 3rem; clip-path: var(--star); background: var(--grad-rose); color: #fff; font-size: 1.2rem; margin-bottom: var(--s-2); }
  .alur h3 { font-size: 1.15rem; }
  @media (min-width: 640px) { .alur { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .alur { grid-template-columns: repeat(4, 1fr); } }
  .help { margin-top: var(--s-7); display: grid; gap: var(--s-5); align-items: end; padding: clamp(2rem, 1.5rem + 3vw, 3.5rem); border-radius: var(--r-lg); overflow: hidden; }
  .help-title { font-size: var(--step-3); color: var(--on-plum); }
  @media (min-width: 960px) { .help { grid-template-columns: 1fr auto; } }

  .grid { display: grid; gap: var(--s-6); }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>

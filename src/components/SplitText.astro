---
/**
 * Judul yang terungkap kata demi kata. Tulis *kata* untuk aksen miring berwarna.
 * Teks utuh tetap terbaca oleh pembaca layar lewat aria-label.
 */
interface Props { text: string; as?: 'h1' | 'h2' | 'h3' | 'p'; class?: string; delay?: number; id?: string }
const { text, as: Tag = 'h2', class: cls, delay = 0, id } = Astro.props;
const plain = text.replace(/\*/g, '');
let italic = false;
const words = text.split(/\s+/).filter(Boolean).map((raw) => {
  let w = raw;
  if (w.startsWith('*')) { italic = true; w = w.slice(1); }
  const isItalic = italic;
  if (w.includes('*')) { italic = false; w = w.replace('*', ''); }
  return { w, isItalic };
});
---
<Tag class:list={['split', cls]} aria-label={plain} data-split id={id} style={`--delay:${delay}ms`}>
  {words.map(({ w, isItalic }, i) => (
    <Fragment><span class="w" aria-hidden="true"><span style={`--i:${i}`}>{isItalic ? <em>{w}</em> : w}</span></span>{' '}</Fragment>
  ))}
</Tag>

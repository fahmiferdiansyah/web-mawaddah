export type IconName = keyof typeof icons;
interface Props { name: IconName; class?: string; label?: string }
const { name, class: cls = '', label } = Astro.props;
---
<svg
  class:list={['icon', `icon-${name}`, cls]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={icons[name]}
/>

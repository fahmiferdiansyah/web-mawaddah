---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
import { tanggal } from '../data/site';
import { kategoriVisual } from '../data/visual';

interface Props { entry: CollectionEntry<'berita'>; i?: number; feature?: boolean }
const { entry, i = 0, feature = false } = Astro.props;
const d = entry.data;
const v = kategoriVisual[d.kategori];
---
<article class:list={['ncard', { feature }]} data-reveal style={`--i:${i}`}>
  <Media image={d.foto} alt={d.fotoAlt || d.title} tone={v.tone} emblem={v.emblem} label={d.title} ratio={feature ? '16 / 10' : '4 / 3'} sizes={feature ? '(min-width: 960px) 55vw, 92vw' : '(min-width: 960px) 30vw, 92vw'} />
  <div class="ncard-body">
    <p class="meta small">
      <span class="tag">{d.kategori}</span>
      <span aria-hidden="true">·</span>
      <time datetime={d.tanggal.toISOString()}>{tanggal(d.tanggal)}</time>
    </p>
    <h3><a href={`/berita/${entry.id}/`}>{d.title}</a></h3>
    {feature && <p class="muted">{d.ringkasan}</p>}
  </div>
</article>

<style>
  .ncard { position: relative; display: grid; gap: var(--s-4); align-content: start; }
  .ncard-body { display: grid; gap: var(--s-3); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5em; color: var(--ink-soft); }
  h3 { font-size: var(--step-1); line-height: 1.3; }
  .feature h3 { font-size: var(--step-3); line-height: 1.12; }
  h3 a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 700ms var(--ease-out), color var(--d-2);
  }
  h3 a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .ncard :global(.ph), .ncard :global(img) { transition: transform 1200ms var(--ease-out); }
  @media (hover: hover) {
    .ncard:hover h3 a { background-size: 100% 1px; color: var(--rose); }
    .ncard:hover :global(.ph), .ncard:hover :global(img) { transform: scale(1.04); }
  }
  .ncard:focus-within :global(.media-clip) { outline: 2px solid var(--rose); outline-offset: 3px; }
</style>

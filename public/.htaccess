# Konfigurasi Apache (Hostinger) untuk situs statis Astro
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Paksa HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Alamat lama -> alamat baru
  RewriteRule ^tentang/?$ /profil/ [L,R=301]
  RewriteRule ^struktur/?$ /pengurus/ [L,R=301]
  RewriteRule ^alamat/?$ /kontak/ [L,R=301]
  RewriteRule ^ifthor-jamai/?$ /iftar-jamai/ [L,R=301]
  RewriteRule ^sarana-air-bersih/?$ /air-bersih/ [L,R=301]
</IfModule>

# Cache aset ber-hash (/_astro) selama setahun
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|png|jpg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
